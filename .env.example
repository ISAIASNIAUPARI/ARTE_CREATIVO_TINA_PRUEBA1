# TinaCMS Cloud — panel de edición en /admin
# Se obtienen en https://app.tina.io  (proyecto conectado al repo de GitHub)

# Público — el panel lo necesita en el navegador
NEXT_PUBLIC_TINA_CLIENT_ID=
NEXT_PUBLIC_TINA_BRANCH=main

# SECRETO — solo variable de servidor. Nunca con prefijo NEXT_PUBLIC_.
TINA_TOKEN=
